<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="../../../version.props"></Import>

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageTags>minimal-apis;aspnetcore;source-generator;endpoints;handlers;asparameters;roslyn;http;rest;ketpsi</PackageTags>
		<Description>Source-generated ASP.NET Core Minimal APIs from plain handler classes. MapGet/MapPost/… over a handler with ExecuteAsync; optional external binding config and AsParameters surrogates. Direct generated mapping with minimal runtime overhead.</Description>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<FrameworkReference Include="Microsoft.AspNetCore.App" Version="10.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
		<PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<FrameworkReference Include="Microsoft.AspNetCore.App" Version="9.0.17" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.17" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<FrameworkReference Include="Microsoft.AspNetCore.App" Version="8.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.28" />

	</ItemGroup>


	<ItemGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
		<PackageReference Include="KetPsi.Endpoints.Abstractions" Version="$(Version)" />
	</ItemGroup>
	<ItemGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
		<ProjectReference Include="..\..\KetPsi.Endpoints.Abstractions\KetPsi.Endpoints.Abstractions.csproj" />
	</ItemGroup>


	<ItemGroup>
		<None Include="..\KetPsi.Endpoints.Http.Generator\bin\$(Configuration)\netstandard2.0\KetPsi.Endpoints.Http.Generator.dll" Pack="true" PackagePath="analyzers\dotnet\cs\KetPsi.Endpoints.Http.Generator.dll" Visible="false" />
	</ItemGroup>

</Project>
