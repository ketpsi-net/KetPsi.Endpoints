<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="../../../version.props"></Import>

	<PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Abstractions for KetPsi code-first gRPC endpoints (proto type configuration)</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The file on disk is README.md; version.props packs README.MD, which does not exist on case-sensitive file systems (NU5019/NU5039). -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="README.MD" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
